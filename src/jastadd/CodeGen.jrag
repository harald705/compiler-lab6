aspect CodeGen {


    public void Program.genCode(PrintStream out) {
        out.println(".global _start");
        // etc.
        out.println(".data");
        out.println("buf: .skip 1024");
        out.println(".text");
        out.println("_start:");
        out.println("       call main");
        // Exiting with code 0
        out.println("       movq $0, %rdi");
        out.println("       movq $60, %rax");
        out.println("       syscall");
        // helper procedures (print/read)
        out.println("print:");
        out.println("        pushq %rbp");
        out.println("        movq %rsp, %rbp");
        out.println("        ### Convert integer to string (itoa).");
        out.println("        movq 16(%rbp), %rax");
        out.println("        leaq buf(%rip), %rsi    # RSI = write pointer (starts at end of buffer)");
        out.println("        addq $1023, %rsi");
        out.println("        movb $0x0A, (%rsi)      # insert newline");
        out.println("        movq $1, %rcx           # RCX = string length");
        out.println("        cmpq $0, %rax");
        out.println("        jge itoa_loop");
        out.println("        negq %rax               # negate to make RAX positive");
        out.println("itoa_loop:                      # do.. while (at least one iteration)");
        out.println("        movq $10, %rdi");
        out.println("        cqo                     # sign extend RAX to RDX to prepare for idiv");
        out.println("        idivq %rdi              # divide RDX:RAX by 10");
        out.println("        addb $0x30, %dl         # remainder + '0'");
        out.println("        decq %rsi               # move string pointer");
        out.println("        movb %dl, (%rsi)");
        out.println("        incq %rcx               # increment string length");
        out.println("        cmpq $0, %rax");
        out.println("        jg itoa_loop            # produce more digits");
        out.println("itoa_done:");
        out.println("        movq 16(%rbp), %rax");
        out.println("        cmpq $0, %rax");
        out.println("        jge print_end");
        out.println("        decq %rsi");
        out.println("        incq %rcx");
        out.println("        movb $0x2D, (%rsi)");
        out.println("print_end:");
        out.println("        movq $1, %rdi");
        out.println("        movq %rcx, %rdx");
        out.println("        movq $1, %rax");
        out.println("        syscall");
        out.println("        popq %rbp");
        out.println("        ret");

        // Read
        out.println("read:");
        out.println("        pushq %rbp");
        out.println("        movq %rsp, %rbp");
        out.println("        ### R9  = sign");
        out.println("        movq $1, %r9            # sign <- 1");
        out.println("        ### R10 = sum");
        out.println("        movq $0, %r10           # sum <- 0");
        out.println("skip_ws: # skip any leading whitespace");
        out.println("        movq $0, %rdi");
        out.println("        leaq buf(%rip), %rsi");
        out.println("        movq $1, %rdx");
        out.println("        movq $0, %rax");
        out.println("        syscall                 # get one char: sys_read(0, buf, 1)");
        out.println("        cmpq $0, %rax");
        out.println("        jle atoi_done           # nchar <= 0");
        out.println("        movb (%rsi), %cl        # c <- current char");
        out.println("        cmp $32, %cl");
        out.println("        je skip_ws              # c == space");
        out.println("        cmp $13, %cl");
        out.println("        je skip_ws              # c == CR");
        out.println("        cmp $10, %cl");
        out.println("        je skip_ws              # c == NL");
        out.println("        cmp $9, %cl");
        out.println("        je skip_ws              # c == tab");
        out.println("        cmp $45, %cl            # check if negative");
        out.println("        jne atoi_loop");
        out.println("        movq $-1, %r9           # sign <- -1");
        out.println("        movq $0, %rdi");
        out.println("        leaq buf(%rip), %rsi");
        out.println("        movq $1, %rdx");
        out.println("        movq $0, %rax");
        out.println("        syscall                 # get one char: sys_read(0, buf, 1)");
        out.println("atoi_loop:");
        out.println("        cmpq $0, %rax           # while (nchar > 0)");
        out.println("        jle atoi_done           # leave loop if nchar <= 0");
        out.println("        movzbq (%rsi), %rcx     # move byte, zero extend to quad-word");
        out.println("        cmpq $0x30, %rcx        # test if < '0'");
        out.println("        jl atoi_done            # character is not numeric");
        out.println("        cmpq $0x39, %rcx        # test if > '9'");
        out.println("        jg atoi_done            # character is not numeric");
        out.println("        imulq $10, %r10         # multiply sum by 10");
        out.println("        subq $0x30, %rcx        # value of character");
        out.println("        addq %rcx, %r10         # add to sum");
        out.println("        movq $0, %rdi");
        out.println("        leaq buf(%rip), %rsi");
        out.println("        movq $1, %rdx");
        out.println("        movq $0, %rax");
        out.println("        syscall                 # get one char: sys_read(0, buf, 1)");
        out.println("        jmp atoi_loop           # loop back");
        out.println("atoi_done:");
        out.println("        imulq %r9, %r10         # sum *= sign");
        out.println("        movq %r10, %rax         # put result value in RAX");
        out.println("        popq %rbp");
        out.println("        ret");

        for (FunctionDecl decl: getFunctionDeclList()) {
            decl.genCode(out);
        }
    }

    public void FunctionDecl.genCode(PrintStream out) {
        out.println(getIdDecl().getID() + ":");
        out.println("       pushq %rbp");
        out.println("       movq %rsp, %rbp");

        // Allocate space for local variables
        if (numLocals() > 0) {
            out.println("       subq $" + (numLocals() * 8) + ", %rsp");
        }

        // Generate assembly for function body
        getBody().genCode(out);

        out.println("       movq %rbp, %rsp");
        out.println("       popq %rbp");
        out.println("       ret");
    }


    public void FunctionCall.genEval(PrintStream out) {
        // Evaluate and push arguments
        for (int i = getNumArgument() - 1; i >= 0; i--) {
            getArgument(i).genEval(out);
            out.println("       pushq %rax");
        }
        
        out.println("       call " + getFunction().getID());

        // Deallocating space on the stack
        if (getNumArgument() > 0) {
            out.println("       addq $" + (getNumArgument() * 8) + ", %rsp");
        }
    }


    public void FunctionCallStmt.genCode(PrintStream out) {
        getFunctionCall().genEval(out);
    }


    public void Block.genCode(PrintStream out) {
        for (Stmt stmt : getStmtList()) {
            stmt.genCode(out);
        }
    }


    public void Stmt.genCode(PrintStream out) {
        // Default
    }


    public void Expression.genEval(PrintStream out) {
        // Default
    }


    public void VDecl.genCode(PrintStream out) {
        if (hasInit()) {
            getInit().genEval(out);
        } else {
            out.println("       movq $0, %rax");
        }
        out.println("       movq %rax, " + getIdDecl().address());
    }


    public void AssignStatement.genCode(PrintStream out) {
        getValue().genEval(out);
        out.println("       movq %rax, " + getTarget().decl().address());
    }


    public void IdUse.genEval(PrintStream out) {
        out.println("       movq " + decl().address() + ", %rax");
    }


    public void ReturnStmt.genCode(PrintStream out) {
        getValue().genEval(out);
        out.println("       movq %rbp, %rsp");
        out.println("       popq %rbp");
        out.println("       ret");
    }


    public void Add.genEval(PrintStream out) {
        getLeft().genEval(out);
        out.println("       pushq %rax");

        getRight().genEval(out);
        out.println("       popq %rbx");

        out.println("       addq %rbx, %rax");
    }


    public void Subtract.genEval(PrintStream out) {
        getLeft().genEval(out);
        out.println("       pushq %rax");

        getRight().genEval(out);
        out.println("       popq %rbx");
        // Reverse order
        out.println("       subq %rax, %rbx");
        out.println("       movq %rbx, %rax");
    }


    public void Multiply.genEval(PrintStream out) {
        getLeft().genEval(out);
        out.println("       pushq %rax");

        getRight().genEval(out);
        out.println("       popq %rbx");
        out.println("       imulq %rbx, %rax");
    }


    public void Divide.genEval(PrintStream out) {
        getLeft().genEval(out);
        out.println("       pushq %rax");

        getRight().genEval(out);
        out.println("       popq %rbx");

        out.println("       xchgq %rax, %rbx");

        out.println("       cqo");
        out.println("       idivq %rbx");
    }


    public void Modulo.genEval(PrintStream out) {
        getLeft().genEval(out);
        out.println("       pushq %rax");

        getRight().genEval(out);
        out.println("       popq %rbx");

        out.println("       xchgq %rax, %rbx");

        out.println("       cqo");
        out.println("       idivq %rbx");
        out.println("       movq %rdx, %rax");
    }


    public void Negate.genEval(PrintStream out) {
        getOperand().genEval(out);
        out.println("       negq %rax");
    }


    public void Expression.genCompare(PrintStream out, Expression left, Expression right) {
        left.genEval(out);
        out.println("       pushq %rax");

        right.genEval(out);
        out.println("       popq %rbx");

        out.println("       cmpq %rax, %rbx");
    }


    public void Expression.genJumpIfFalse(PrintStream out, String label) {
        throw new UnsupportedOperationException("Cannot generate conditional jump for this expression");
    }


    public void Equal.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       jne " + label);
    }


    public void NotEqual.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       je " + label);
    }


    public void LessThan.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       jge " + label);
    }


    public void LessEqual.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       jg " + label);
    }


    public void GreaterThan.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       jle " + label);
    }


    public void GreaterEqual.genJumpIfFalse(PrintStream out, String label) {
        genCompare(out, getLeft(), getRight());
        out.println("       jl " + label);
    }


    public void Numeral.genEval(PrintStream out) {
        out.println("       movq $" + getNUMERAL() + ", %rax");
    }


    inh String ASTNode.functionName();

    eq FunctionDecl.getBody().functionName() = getIdDecl().getID();
    
    syn String IfStmt.elseLabel() = functionName() + "else_" + uniquePrefix();
    syn String IfStmt.endLabel() = functionName() + "endif_" + uniquePrefix();

    syn String WhileStmt.startLabel() = functionName() + "while_start_" + uniquePrefix();
    syn String WhileStmt.endLabel() = functionName() + "endif_" + uniquePrefix();

    
    public void IfStmt.genCode(PrintStream out) {
        getCondition().genJumpIfFalse(out, elseLabel());
        getThen().genCode(out);
        out.println("       jmp " + endLabel());

        out.println(elseLabel() + ":");
        if (hasElse()) {
            getElse().genCode(out);
        }

        out.println(endLabel() + ":");
    }


    public void WhileStmt.genCode(PrintStream out) {
        out.println(startLabel() + ":");
        getCondition().genJumpIfFalse(out, endLabel());
        
        // Generate loop body
        getBody().genCode(out);

        out.println("       jmp " + startLabel());
        out.println(endLabel() + ":");
    }


    syn HashMap<IdDecl, Integer> FunctionDecl.localMap() {
        HashMap<IdDecl, Integer> m = new HashMap<>();
        Counter c = new Counter();
        getBody().addLocals(m, c);
        return m;
    }

    public void ASTNode.addLocals(HashMap<IdDecl, Integer> m, Counter c) {
        for (ASTNode child : astChildren()) {
            child.addLocals(m, c);
        }
    }

    public void VDecl.addLocals(HashMap<IdDecl, Integer> m, Counter c) {
        c.increment();
        m.put(getIdDecl(), c.value());
    }


    syn int FunctionDecl.numLocals() = localMap().size();

    inh HashMap<IdDecl, Integer> IdDecl.localMap();
    eq FunctionDecl.getBody().localMap() = localMap();


    inh int Parameter.parameterIndex();
    eq FunctionDecl.getParameter(int index).parameterIndex() = index;

    syn int IdDecl.localIndex() = localMap().get(this);
    //syn String IdDecl.address() = "-" + (localIndex() * 8) + "(%rbp)";
    inh String IdDecl.address();
    eq VDecl.getIdDecl().address() = "-" + (getIdDecl().localIndex() * 8) + "(%rbp)";
    eq Parameter.getIdDecl().address() = (16 + parameterIndex() * 8) + "(%rbp)";

    public class Counter {
        int count = 0;
        void increment() {
            count++;
        }

        int value() {
            return count;
        }
    }


}