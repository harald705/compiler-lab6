import java.util.Set;
import java.util.TreeSet;

aspect Errors {
    public class ErrorMessage implements Comparable<ErrorMessage> {
        protected final String message;
        protected final int lineNumber;
        public ErrorMessage(String message, int lineNumber) {
            this.message = message;
            this.lineNumber = lineNumber;
        }
        public int compareTo(ErrorMessage other) {
            if (lineNumber == other.lineNumber) {
                return message.compareTo(other.message);
            }
            return Integer.compare(lineNumber, other.lineNumber); 
        }
        public String toString() {
            return "Error at line " + lineNumber + ": " + message;
        }
    } 
    protected ErrorMessage ASTNode.error(String message) {
        return new ErrorMessage(message, startLine());
    }

    syn int ASTNode.startLine() = getLine(getStart());
    syn int ASTNode.startCol() = getColumn(getStart());

    coll Set<ErrorMessage> Program.errors() [new TreeSet<ErrorMessage>()] with add root Program;

    inh Program ASTNode.program();
    eq Program.getChild().program() = this;
}


aspect ErrorContributions {
    IdUse contributes error("symbol '" + getID() + "' is not declared")
        when decl().isUnknown()
        to Program.errors() for program();

    IdDecl contributes error("symbol '" + getID() + "' is already declared!")
        when isDeclaredMult()
        to Program.errors() for program();

    IdUse contributes error("the definition of symbol '" + getID() + "' is circular")
        when isCircular()
        to Program.errors() for program();

    FunctionCall contributes error("function '" + getFunction().getID() + "' expects "
            + getFunction().decl().function().getNumParameter() + " arguments, got " + getNumArgument())
        when getFunction().decl().isFunction()
            && getNumArgument() != getFunction().decl().function().getNumParameter()
        to Program.errors() for program();

    IdUse contributes error(isFunctionUse() ? "'" + getID() + "' is a variable not a function" : "'" + getID() + "' is a function not a variable") when !decl().isUnknown() && decl().isFunction() != isFunctionUse() to Program.errors() for program();
    
    Expression contributes error("type mismatch expected " + expectedType().name()
            + " but received " + type().name())
        when !type().compatibleType(expectedType())
        to Program.errors() for program();
}
