int gcd1(int a, int b) {
    while (a != b) {
        if (a > b) {
            a = a - b;
        } else {
            b = b - a;
        }
    }
    return a;
}

int gcd2(int a, int b) {
    if (b == 0) {
        return a;
    }
    return gcd2(b, a % b);
}

int main() {
    int x;
    int y;
    x = 24;
    y = 20;
    print(gcd1(x, y));
    print(gcd2(x, y));
    int diff = gcd1(x, y) - gcd2(x, y);
    print(diff);
    return 0;
}
